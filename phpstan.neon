includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Model concerns are used from M4 onwards; remove once a model uses them.
        -
            identifier: trait.unused
            path: app/Models/Concerns/*
