APP_NAME="Baines Executives"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Quick sign-in dropdown on the login page (APP_ENV=local only)
DEV_LOGIN=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Host MySQL 8 (create the database and user first; see README)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=baines
DB_USERNAME=baines
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Horizon only works the redis connection: use QUEUE_CONNECTION=redis on staging and
# production. Locally `composer dev` runs queue:listen on the database queue.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Redis and Horizon run in production only (local dev uses the database drivers above).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is written to storage/logs/laravel.log locally
# Mail goes to the log locally. To see rendered mails, run Mailpit and use
# MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025 (UI on :8025).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bookings@baines.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage, only used when MEDIA_*_DISK point at the s3 disks
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_BUCKET=baines-public
AWS_PRIVATE_BUCKET=baines-private

# Media module (TECHNICAL_PLAN §6). Switch to media-public-s3 / media-private-s3
# to use the S3 buckets; existing files stay readable on their original disk.
MEDIA_PUBLIC_DISK=media-public-local
MEDIA_PRIVATE_DISK=media-private-local
MEDIA_SIGNED_URL_TTL=5
MEDIA_PENDING_TTL=1440
MEDIA_PUBLIC_SERVE=redirect

# FX rates (TECHNICAL_PLAN §10, D28): the Open Exchange Rates app ID. Pick the provider in Settings → Exchange rates.
FX_API_KEY=

# WhatsApp (TECHNICAL_PLAN §13): click_to_chat | cloud_api
WHATSAPP_DRIVER=click_to_chat
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# Cloudflare Turnstile. These are Cloudflare's always-pass test keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=

ADMIN_IDLE_MINUTES=30

VITE_APP_NAME="${APP_NAME}"
VITE_TURNSTILE_SITE_KEY="${TURNSTILE_SITE_KEY}"
